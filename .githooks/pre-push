#!/bin/sh
# Führt die Skripte in .githooks/pre-push.d/ der Reihe nach aus.
# Scheitert eines, bricht der Push ab. Einrichten (einmal pro Klon): make setup
dir="$(dirname "$0")/pre-push.d"
[ -d "$dir" ] || exit 0
for script in "$dir"/*; do
  [ -x "$script" ] || continue
  "$script" "$@" </dev/null || exit $?
done
